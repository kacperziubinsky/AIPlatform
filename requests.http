@GatewayUrl = http://127.0.0.1:8080

# Wklej tokeny z odpowiedzi logowania (KROK 3 i KROK 4)
@recruiterToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..KHcxieRqJtSwu5gZRD4sDYisX83RE7CO7NEYuTdAt3s
@candidateToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Z0WLSe9_OtLMzwJBO3-AHodjGZkE4eFFc0xYmwPs8UA
# Wklej ID z odpowiedzi
@createdOfferId = 44802ab1-d715-4793-a121-660a4d2208d6
@candidateId = 00-897f479a08a22f384bdd3ba6ab8d584f-ce714d0e21c2b833-00


### ==================================================================
### 1. AUTH SERVICE - Rejestracja i logowanie
### ==================================================================

### KROK 1: Rejestracja rekrutera
POST {{GatewayUrl}}/auth/auth/register
Content-Type: application/json

{
  "email": "recruiter.kacper@example.com",
  "password": "Password123!",
  "role": "Recruiter"
}

###

### KROK 2: Rejestracja kandydata
# 💡 Auth po rejestracji tworzy pusty profil w User Service (wewnętrzny request)
POST {{GatewayUrl}}/auth/auth/register
Content-Type: application/json

{
  "email": "candidateeeee.kacper@example.com",
  "password": "Password123!",
  "role": "Applicant"
}

<> 2026-10-07T184510.200.json
<> 2026-10-07T182409.200.json
<> 2026-10-07T182345.400.json
<> 2026-10-07T182304.400.json

###

### KROK 3: Logowanie rekrutera
# 💡 Skopiuj "token" do @recruiterToken
POST {{GatewayUrl}}/auth/auth/login
Content-Type: application/json

{
  "email": "recruiter.kacper@example.com",
  "password": "Password123!"
}

<> 2026-10-07T183601.200.json
<> 2026-10-07T183235.200.json
<> 2026-10-07T182902.200.json
<> 2026-10-07T182322.200.json

###

### KROK 4: Logowanie kandydata
# 💡 Skopiuj "token" do @candidateToken
POST {{GatewayUrl}}/auth/auth/login
Content-Type: application/json

{
  "email": "candidateeeee.kacper@example.com",
  "password": "Password123!"
}

<> 2026-10-07T184547.200.json
<> 2026-10-07T182923.200.json
<> 2026-10-07T182432.200.json

###

### KROK 5: Rejestracja z zajętym e-mailem (oczekiwane 409)
POST {{GatewayUrl}}/auth/auth/register
Content-Type: application/json

{
  "email": "candidate.kacper@example.com",
  "password": "Password123!",
  "role": "Applicant"
}

<> 2026-10-07T182436.400.json

